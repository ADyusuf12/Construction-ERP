<% content_for :title, "#{@expense.description} | Expense Record" %>
<div class="animate-fade-in space-y-8">
  <!-- Expense Header Card -->
  <div class="bg-brand-white/30 dark:bg-brand-black/30 backdrop-blur-md border border-brand-secondary/20 rounded-2xl shadow-2xl p-8 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1 bg-brand-primary opacity-40"></div>
    <div class="flex flex-col md:flex-row items-start gap-6">
      <div class="flex-1">
        <h2 class="text-3xl font-black text-brand-secondary dark:text-white uppercase tracking-tighter italic mb-2">
          <%= @expense.description %>
        </h2>
        <p class="text-sm text-brand-secondary/70 dark:text-white/70 leading-relaxed italic border-l-2 border-brand-primary/30 pl-4">
          Logged on <%= @expense.date.strftime("%B %d, %Y") %>
        </p>
      </div>
      <div class="flex flex-col items-end gap-2">
        <span class="px-3 py-1 rounded-lg bg-brand-primary/10 border border-brand-primary/20 text-[9px] font-black uppercase tracking-[0.2em] text-brand-primary">
          Project: <%= @expense.project.name %>
        </span>
        <span class="text-2xl font-black text-green-600 dark:text-green-400">
          <%= number_to_currency(@expense.amount, unit: "₦") %>
        </span>
      </div>
    </div>
    <% if @expense.reference.present? || @expense.notes.present? %>
      <div class="mt-6 pt-4 border-t border-brand-secondary/10 space-y-2">
        <% if @expense.reference.present? %>
          <p class="text-sm font-bold text-brand-secondary dark:text-white">
            Reference: <span class="font-normal italic"><%= @expense.reference %></span>
          </p>
        <% end %>
        <% if @expense.notes.present? %>
          <p class="text-sm font-bold text-brand-secondary dark:text-white">
            Notes: <span class="font-normal italic"><%= @expense.notes %></span>
          </p>
        <% end %>
      </div>
    <% end %>
    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to edit_project_project_expense_path(@expense.project, @expense),
          class: "flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-primary text-white text-[10px] font-black uppercase tracking-widest shadow-lg hover:bg-brand-black transition-all active:scale-95" do %>
        Edit Expense
      <% end %>
      <%= link_to project_path(@expense.project),
          class: "flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-secondary/10 text-brand-secondary dark:text-brand-primary border border-brand-secondary/20 text-[10px] font-black uppercase tracking-widest hover:bg-brand-secondary hover:text-white transition-all" do %>
        Back to Project
      <% end %>
      <button type="button"
          class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-red-600 text-white text-[10px] font-black uppercase tracking-widest shadow-lg hover:bg-red-800 transition-all active:scale-95"
          data-action="click->confirm-modal#open"
        data-confirm-modal-variant-param="danger"
        data-confirm-modal-title-param="Delete Expense?"
        data-confirm-modal-message-param="Are you sure you want to delete this expense? This action cannot be undone."
        data-confirm-modal-confirm-path-param="<%= project_project_expense_path(@expense.project, @expense) %>"
        data-confirm-modal-confirm-method-param="delete">
        Delete
      </button>
    </div>
  </div>
</div>
