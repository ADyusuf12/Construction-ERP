<% if Rails.env.development? || Rails.env.test? %>
  <div data-controller="user-switcher"
       class="fixed bottom-4 right-4 z-50 bg-brand-secondary/90 dark:bg-brand-black/90 backdrop-blur-md border border-brand-primary/20 rounded-xl shadow-2xl p-4 transition-all duration-300 max-w-xs"
       data-user-switcher-target="container">
    <div class="flex items-center justify-between gap-4 border-b border-white/10 pb-2 mb-3">
      <div class="text-[10px] font-black uppercase tracking-widest text-brand-primary">
        Dev Tool: User Switcher
      </div>
      <button data-action="click->user-switcher#toggle"
        class="text-xs text-white/50 hover:text-white px-1.5 py-0.5 rounded border border-white/10 hover:bg-white/5 cursor-pointer">
        <span data-user-switcher-target="btnText">Collapse</span>
      </button>
    </div>
    <div data-user-switcher-target="content" class="space-y-3">
      <% if current_user %>
        <div class="text-[11px] font-mono text-white/70">
          Logged in: <span class="text-brand-primary font-bold"><%= current_user.full_name %></span>
          (<%= current_user.role&.upcase %>)
        </div>
      <% end %>
      <%= form_with url: dev_user_switchers_path, method: :post, local: true, class: "space-y-2" do |f| %>
        <div>
          <%# Collect all users that have an email and a defined role %>
          <% select_options = User.where.not(email: nil).order(:role).map { |u| ["#{u.role.upcase} — #{u.email}", u.id] } %>
          <%= f.select :user_id,
                       options_for_select(select_options, selected: current_user&.id),
                       { include_blank: "Select Persona..." },
                       { class: "w-full bg-black/40 dark:bg-black/40 border border-white/20 text-white text-xs rounded-lg px-2.5 py-2 focus:ring-1 focus:ring-brand-primary outline-none cursor-pointer" } %>
        </div>
        <%= f.submit "Swap Identity",
                     class: "w-full text-center px-4 py-2 rounded-lg bg-brand-primary text-white font-black uppercase tracking-widest text-[10px] shadow-lg hover:bg-white hover:text-brand-secondary transition-all duration-300 cursor-pointer active:scale-95" %>
      <% end %>
    </div>
  </div>
<% end %>